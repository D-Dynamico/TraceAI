# Copy to frontend/.env only if you need to point the UI at a non-local API.
#
# Leave this UNSET for normal local development: empty means every request stays
# a same-origin /api/* path and vite.config.js proxies it to the backend on
# :8000. That is also what the test suite asserts against.
#
# Set it to the deployed backend's origin (no trailing slash) when building for
# production — in Vercel's dashboard, not in a committed file:
#     VITE_API_URL=https://traceai-api.onrender.com
#
# Vite inlines this at BUILD time, so changing it requires a rebuild/redeploy of
# the frontend, not just a restart.
VITE_API_URL=
