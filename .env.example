# Copy to .env and fill in. Used from Phase 2 onward.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
DEBUG=true

# Read scans and images with Gemini Vision when local OCR (Tesseract/Poppler)
# yields nothing. Leave on unless those binaries are installed and you would
# rather save the extra Gemini call per scanned upload — with it off and no
# Tesseract, a scanned document is stored with no text at all.
#
# Note the free tier is 20 requests/DAY, and a scanned upload costs two of them
# (Vision, then categorization). See ai/gemini.py.
VISION_OCR_ENABLED=true
